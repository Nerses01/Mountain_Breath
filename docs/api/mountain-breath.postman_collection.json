{
	"info": {
		"_postman_id": "a7c3e8d0-5b2f-4e9a-9c41-3f8b2d6e1a05",
		"name": "Mountain Breath API",
		"description": "Living API contract for the Mountain Breath backend.\n\n**Rule (docs/RULES.md):** every commit that adds, changes, or removes a route must update this collection in the same commit — request, variables, and tests.\n\n**Usage:** start the API (`go run ./cmd/api` in `backend/`), then send requests here, or use the Collection Runner to execute the whole suite as a smoke test. Postman's cookie jar carries the session cookie between requests automatically.\n\n**Admin folder:** set the collection variables `adminEmail` / `adminPassword` to a local admin account first (register a user, then promote it: `UPDATE users SET role='admin' WHERE email='...';` via psql). Values are not committed — they are your local secrets.\n\nFolders mirror the roadmap phases from docs/PROJECT_PLAN.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "apiV1",
			"value": "{{baseUrl}}/api/v1",
			"type": "string"
		},
		{
			"key": "adminEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminPassword",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "System",
			"description": "Operational endpoints — not part of the business API.",
			"item": [
				{
					"name": "Health check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Liveness probe. Returns 200 with `{\"status\":\"ok\"}` while the server is up. Later used by Docker healthchecks (Phase 8) and the load balancer (Phase 9)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"content-type is application/json\", () => {",
									"    pm.response.to.have.header(\"Content-Type\", \"application/json\");",
									"});",
									"",
									"pm.test(\"body is {status: ok}\", () => {",
									"    pm.expect(pm.response.json().status).to.eql(\"ok\");",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Slow endpoint (dev only)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/debug/slow",
							"host": ["{{baseUrl}}"],
							"path": ["debug", "slow"]
						},
						"description": "Sleeps 5 seconds, then responds. Registered only when `MB_ENV=dev`. For observing graceful shutdown and client cancellation."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"actually took ~5 seconds\", () => {",
									"    pm.expect(pm.response.responseTime).to.be.at.least(4500);",
									"});"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
			"name": "Auth (Phase 4)",
			"description": "Session-cookie auth. The cookie (mb_session, HttpOnly, SameSite=Lax) is set by register/login and carried automatically by Postman's cookie jar. Run these top-to-bottom.",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{authEmail}}\",\n    \"password\": \"test-password-123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apiV1}}/auth/register",
							"host": ["{{apiV1}}"],
							"path": ["auth", "register"]
						},
						"description": "Creates a customer account and starts a session. The pre-request script generates a unique email per run."
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set(\"authEmail\", \"user-\" + Date.now() + \"@test.local\");"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 201\", () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"new users are customers\", () => {",
									"    pm.expect(pm.response.json().role).to.eql(\"customer\");",
									"});",
									"",
									"pm.test(\"session cookie set\", () => {",
									"    pm.expect(pm.cookies.has(\"mb_session\")).to.be.true;",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Me (current session)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/auth/me",
							"host": ["{{apiV1}}"],
							"path": ["auth", "me"]
						},
						"description": "Returns the logged-in user, resolved from the session cookie. 401 without a valid session."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"email matches the registered user\", () => {",
									"    pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"authEmail\"));",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Login — wrong password (401)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{authEmail}}\",\n    \"password\": \"definitely-wrong\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apiV1}}/auth/login",
							"host": ["{{apiV1}}"],
							"path": ["auth", "login"]
						},
						"description": "Wrong password and unknown email return the SAME error — the API must not reveal which accounts exist (user enumeration)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 401\", () => {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"error code is invalid_credentials\", () => {",
									"    pm.expect(pm.response.json().error.code).to.eql(\"invalid_credentials\");",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/auth/logout",
							"host": ["{{apiV1}}"],
							"path": ["auth", "logout"]
						},
						"description": "Deletes the session server-side and expires the cookie."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 204\", () => {",
									"    pm.response.to.have.status(204);",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Me after logout (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/auth/me",
							"host": ["{{apiV1}}"],
							"path": ["auth", "me"]
						},
						"description": "The session is gone server-side — the old cookie (if any survived) is worthless."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 401\", () => {",
									"    pm.response.to.have.status(401);",
									"});"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
			"name": "Catalog (Phase 2/3)",
			"description": "Public read-only catalog. Writes live under Admin.",
			"item": [
				{
					"name": "List categories",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/categories",
							"host": ["{{apiV1}}"],
							"path": ["categories"]
						},
						"description": "Returns all categories ordered by sort_order, then name. Always an array — [] when empty, never null."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"body is an array\", () => {",
									"    pm.expect(pm.response.json()).to.be.an(\"array\");",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "List products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/products?category=&page=1&per_page=20",
							"host": ["{{apiV1}}"],
							"path": ["products"],
							"query": [
								{
									"key": "category",
									"value": "",
									"description": "optional category slug filter, e.g. herbal-tea"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "20",
									"description": "1..100, default 20"
								}
							]
						},
						"description": "Paginated list of active products with nested variants (sorted by price). Envelope: {items, page, per_page, total}."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const body = pm.response.json();",
									"",
									"pm.test(\"has pagination envelope\", () => {",
									"    pm.expect(body).to.have.keys(\"items\", \"page\", \"per_page\", \"total\");",
									"    pm.expect(body.items).to.be.an(\"array\");",
									"});",
									"",
									"pm.test(\"every product has variants array\", () => {",
									"    body.items.forEach(p => pm.expect(p.variants).to.be.an(\"array\"));",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Get product by slug",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/products/armenian-coffee",
							"host": ["{{apiV1}}"],
							"path": ["products", "armenian-coffee"]
						},
						"description": "Product detail with variants. Slug comes from seed data."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const body = pm.response.json();",
									"",
									"pm.test(\"slug matches request\", () => {",
									"    pm.expect(body.slug).to.eql(\"armenian-coffee\");",
									"});",
									"",
									"pm.test(\"variants sorted by price ascending\", () => {",
									"    const prices = body.variants.map(v => v.price_minor);",
									"    pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Get product — unknown slug (404)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/products/no-such-product",
							"host": ["{{apiV1}}"],
							"path": ["products", "no-such-product"]
						},
						"description": "Unknown slug returns 404 with the standard error envelope."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 404\", () => {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"error code is not_found\", () => {",
									"    pm.expect(pm.response.json().error.code).to.eql(\"not_found\");",
									"});"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
			"name": "Admin (Phase 4)",
			"description": "Admin-only writes. Requires the collection variables adminEmail/adminPassword (see collection description). Run 'Login as admin' first — the session cookie then authorizes the rest.",
			"item": [
				{
					"name": "Login as admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apiV1}}/auth/login",
							"host": ["{{apiV1}}"],
							"path": ["auth", "login"]
						},
						"description": "Fails (401) until adminEmail/adminPassword variables point to a promoted admin account."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200 — set adminEmail/adminPassword variables if this fails\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"user is an admin\", () => {",
									"    pm.expect(pm.response.json().role).to.eql(\"admin\");",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Create category",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"slug\": \"{{newCatSlug}}\",\n    \"name\": \"Test Category\",\n    \"sort_order\": 100\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apiV1}}/admin/categories",
							"host": ["{{apiV1}}"],
							"path": ["admin", "categories"]
						},
						"description": "Creates a category (admin only — 401 anonymous, 403 customer). The pre-request script generates a unique slug each run."
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set(\"newCatSlug\", \"test-cat-\" + Date.now());"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 201\", () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"const body = pm.response.json();",
									"",
									"pm.test(\"echoes the slug back\", () => {",
									"    pm.expect(body.slug).to.eql(pm.collectionVariables.get(\"newCatSlug\"));",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Create category — duplicate slug (409)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"slug\": \"{{newCatSlug}}\",\n    \"name\": \"Same Slug Again\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apiV1}}/admin/categories",
							"host": ["{{apiV1}}"],
							"path": ["admin", "categories"]
						},
						"description": "Reuses {{newCatSlug}} from the previous request. The UNIQUE constraint surfaces as 409 + code slug_taken."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 409\", () => {",
									"    pm.response.to.have.status(409);",
									"});",
									"",
									"pm.test(\"error code is slug_taken\", () => {",
									"    pm.expect(pm.response.json().error.code).to.eql(\"slug_taken\");",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "List all orders",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/admin/orders",
							"host": ["{{apiV1}}"],
							"path": ["admin", "orders"]
						},
						"description": "Every order (latest 200), newest first, with customer emails. Admin only."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Update order status",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"confirmed\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apiV1}}/admin/orders/1/status",
							"host": ["{{apiV1}}"],
							"path": ["admin", "orders", "1", "status"]
						},
						"description": "Drives the state machine: pending → confirmed → shipped → delivered; cancelled reachable from pending/confirmed (and restores stock). Illegal transition → 409 invalid_transition."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"transition accepted (200) or correctly refused (409)\", () => {",
									"    pm.expect([200, 409]).to.include(pm.response.code);",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Create category — validation errors (400)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"slug\": \"BAD SLUG\",\n    \"name\": \"\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apiV1}}/admin/categories",
							"host": ["{{apiV1}}"],
							"path": ["admin", "categories"]
						},
						"description": "Empty name + malformed slug → 400 with the standard error envelope and a per-field breakdown."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 400\", () => {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"const err = pm.response.json().error;",
									"",
									"pm.test(\"error code is validation_failed\", () => {",
									"    pm.expect(err.code).to.eql(\"validation_failed\");",
									"});",
									"",
									"pm.test(\"reports both bad fields\", () => {",
									"    pm.expect(err.fields).to.have.property(\"name\");",
									"    pm.expect(err.fields).to.have.property(\"slug\");",
									"});"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
			"name": "Cart & Orders (Phase 5)",
			"description": "Requires a logged-in session (run Auth → Register first; Postman's cookie jar carries it). PUT /cart/items has SET semantics — sending qty twice leaves one line with that qty.",
			"item": [
				{
					"name": "Get cart",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apiV1}}/cart",
							"host": ["{{apiV1}}"],
							"path": ["cart"]
						},
						"description": "The logged-in user's cart with live prices/stock and computed totals. 401 anonymous."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
