# Copy to deploy/backup.env (git-ignored) — read by mb-backup.service and
# passed to deploy/backup.sh. Every line is optional; unset = the
# script's default. Full setup: docs/DEPLOYMENT.md step 7b.

# Off-machine copy: an rclone remote and bucket. Leave commented to keep
# backups on this machine only.
#MB_BACKUP_REMOTE=r2:mountain-breath-backups
# Remote retention for database dumps, in days (local keeps the newest
# 14 by count; uploads archives are never pruned remotely).
#MB_REMOTE_KEEP_DAYS=60
