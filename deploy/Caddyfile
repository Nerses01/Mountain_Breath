# Caddy config: one line of substance. Caddy sees a real domain, obtains a
# Let's Encrypt certificate for it, renews it forever, and redirects HTTP
# to HTTPS — all by default, zero certificate commands.
{
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	encode gzip
	
	# Intercept any request starting with /api/ and send it to the C++ backend
	reverse_proxy /api/* api:8080
	
	# Send everything else (HTML, CSS, JS) to the frontend container
	reverse_proxy web:80
}