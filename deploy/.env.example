# Copy this file to deploy/.env and fill in real values.
# deploy/.env is git-ignored — secrets never enter the repository (RULES.md #12).

POSTGRES_USER=mb
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=mountain_breath
DOMAIN=shop.example.com
GRAFANA_PASSWORD=choose-a-password

# ── E8: mail and Google sign-in (all optional) ───────────────────────────
# The origin the BROWSER uses — emailed links and the OAuth redirect point
# here. In the containerized stack that is nginx.
# MB_PUBLIC_URL=http://localhost
# SMTP relay for outgoing mail; unset = messages land in the api log.
# MB_SMTP_ADDR=
# MB_SMTP_USERNAME=
# MB_SMTP_PASSWORD=
# MB_MAIL_FROM=Mountain Breath <hive@shop.example.com>
# Google OAuth client (decision #5); unset = the button explains itself.
# MB_GOOGLE_CLIENT_ID=
# MB_GOOGLE_CLIENT_SECRET=
