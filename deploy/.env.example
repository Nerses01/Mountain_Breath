# Copy this file to deploy/.env and fill in real values.
# deploy/.env is git-ignored — secrets never enter the repository (RULES.md #12).

POSTGRES_USER=mb
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=mountain_breath
# The site's hostname — the one configured as the tunnel's public hostname
# in the Cloudflare dashboard (docs/DEPLOYMENT_HOME.md, step 7).
DOMAIN=shop.example.com
GRAFANA_PASSWORD=choose-a-password

# ── Cloudflare named tunnel (decision #100, home server) ─────────────────
# Identifies this machine's cloudflared connector to Cloudflare. From:
# Zero Trust dashboard → Networks → Tunnels → your tunnel → install
# connector (the long string after `--token` in the shown command).
CLOUDFLARE_TUNNEL_TOKEN=paste-the-tunnel-token

# ── E8: mail and Google sign-in (all optional) ───────────────────────────
# The origin the BROWSER uses — emailed links and the OAuth redirect point
# here. In the containerized stack that is nginx.
# MB_PUBLIC_URL=http://localhost
# SMTP relay for outgoing mail; unset = messages land in the api log.
# Production uses Resend over SMTP (decision #104, docs/DEPLOYMENT_HOME.md
# step 11): port 587 upgrades to TLS with STARTTLS, port 465 is TLS from
# the first byte — both work, and credentials never travel unencrypted.
# The From address must be on the domain verified at Resend.
# MB_SMTP_ADDR=smtp.resend.com:587
# MB_SMTP_USERNAME=resend
# MB_SMTP_PASSWORD=re_xxxxxxxx        # an API key with "Sending access" only
# MB_MAIL_FROM=Mountain Breath <hive@shop.example.com>
# Google OAuth client (decision #5); unset = the button explains itself.
# MB_GOOGLE_CLIENT_ID=
# MB_GOOGLE_CLIENT_SECRET=
