# Copy to backend/.env and fill in values from deploy/.env.
# backend/.env is git-ignored — never commit credentials.

MB_DATABASE_URL=postgres://mb:YOUR_PASSWORD@localhost:5432/mountain_breath?sslmode=disable
# MB_ADDR=:8080
# MB_ENV=dev

# ── E8: mail, links, Google sign-in ──────────────────────────────────────
# The dev mail catcher (docker compose dev stack); read the mailbox at
# http://localhost:8025. Unset = messages land in the server log instead.
MB_SMTP_ADDR=localhost:1025
# A real relay is host:587 (STARTTLS) or host:465 (TLS from the first byte);
# the api waits at most 10 s per message. Production values: deploy/.env.example.
# MB_SMTP_USERNAME=
# MB_SMTP_PASSWORD=
# MB_MAIL_FROM=Mountain Breath <hive@mountain-breath.local>

# The origin THE BROWSER uses — goes into emailed links and the OAuth
# redirect URI. Default is the Vite dev server.
# MB_PUBLIC_URL=http://localhost:5173

# "Continue with Google" (decision #5). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application)
# with redirect URI http://localhost:5173/api/v1/auth/oauth/google/callback
# and paste its id/secret here. Both unset = the flow answers 404 and the
# login page's button explains itself.
# MB_GOOGLE_CLIENT_ID=
# MB_GOOGLE_CLIENT_SECRET=

# Decision #110: the account a bank transfer goes to — shown on the order
# page and in the confirmation mail while unpaid. Unset = "we will email
# you the details", so dev needs nothing here.
# MB_BANK_RECIPIENT=Mountain Breath
# MB_BANK_NAME=Ameriabank
# MB_BANK_IBAN=AM00 0000 0000 0000 0000
